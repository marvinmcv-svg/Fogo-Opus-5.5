# Required for the AI receptionist (Sofía)
ANTHROPIC_API_KEY=

# Protects /admin (reservation board). Choose a long random string.
ADMIN_PASSWORD=

# Vercel Blob (set automatically on Vercel when the store is connected).
# Without it, reservations are stored in RESERVATIONS_FILE / ./data/reservations.json
BLOB_READ_WRITE_TOKEN=

# Optional: local reservations file
RESERVATIONS_FILE=
